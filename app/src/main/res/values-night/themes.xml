<resources>
    <!-- Base application dark theme (Material 3) -->
    <style name="Theme.CurrencyGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/status_genuine</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.CurrencyGuard.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.CurrencyGuard.BottomNav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CurrencyGuard.ActiveIndicator</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
    </style>

    <style name="Widget.CurrencyGuard.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">44dp</item>
        <item name="android:height">28dp</item>
        <item name="android:color">@color/primary_container</item>
    </style>

    <style name="ThemeOverlay.CurrencyGuard.BottomNav" parent="">
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
    </style>
</resources>
